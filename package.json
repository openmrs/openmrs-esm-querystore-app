{
  "name": "@openmrs/esm-querystore-app",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "description": "O3 query store: an omnibar provider for values in the open chart, from the query store, and the warm-up when a chart opens (prototype)",
  "browser": "dist/openmrs-esm-querystore-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode production",
    "lint": "eslint src --max-warnings 0",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\" --list-different",
    "typescript": "tsc",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "verify": "turbo lint typescript coverage",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "extract-translations": "i18next 'src/**/*.{ts,tsx}' --config ./tools/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-querystore-app.git"
  },
  "homepage": "https://github.com/openmrs/openmrs-esm-querystore-app#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-querystore-app/issues"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "10.x || 11.x",
    "react": "18.x",
    "react-i18next": "16.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/eslint-config": "^2.1.0",
    "@openmrs/esm-framework": "11.0.0",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.6",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "happy-dom": "^20.0.0",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.3.0",
    "openmrs": "11.0.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "swr": "2.5.1",
    "turbo": "^2.5.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "yarn@4.10.3"
}
